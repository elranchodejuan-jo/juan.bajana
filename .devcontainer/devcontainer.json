{
  "name": "EVA Cloud Browser",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "Navegador EVA (privado)",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "runArgs": ["--shm-size=1gb"],
  "postCreateCommand": "bash .devcontainer/eva-cloud-browser/setup.sh",
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
